    on_channel_chat                     22  cancel     player:obj type:u32 lang:u32 msg:str! channel:h.channel
    on_emote                            23  broadcast  player:obj emote:u32
    on_text_emote                       24  broadcast  player:obj textEmote:u32 emoteNum:u32 guid:obj
    on_save                             25  broadcast  player:obj
    on_bind_to_instance                 26  broadcast  player:obj difficulty:enum mapid:u32 permanent:bool
    on_update_zone                      27  broadcast  player:obj newZone:u32 newArea:u32
    on_map_change                       28  broadcast  player:obj
    on_equip                            29  broadcast  player:obj item:obj bag:u32 slot:u32
    on_first_login                      30  broadcast  player:obj
    on_can_use_item                     31  broadcast  player:obj itemEntry:u32 result:u32!
    on_loot_item                        32  broadcast  player:obj item:obj count:u32 guid:obj
    on_enter_combat                     33  broadcast  player:obj enemy:obj
    on_leave_combat                     34  broadcast  player:obj
    on_repop                            35  broadcast  player:obj
    on_resurrect                        36  broadcast  player:obj
    on_loot_money                       37  broadcast  player:obj amount:u32
    on_quest_abandon                    38  broadcast  player:obj questId:u32
    on_learn_talents                    39  broadcast  player:obj talentId:u32 talentRank:u32 spellid:u32
    on_environmental_death              40  broadcast  killed:obj damageType:u32
    on_trade_accept                     41  cancel     trader:obj tradee:obj
    on_command                          42  cancel     player:obj text:str
    on_skill_change                     43  broadcast  player:obj skillId:u32 skillValue:u32
    on_learn_spell                      44  broadcast  player:obj spellid:u32
    on_achievement_complete             45  broadcast  player:obj achievementId:u32
    on_discover_area                    46  broadcast  player:obj area:u32
    on_update_area                      47  broadcast  player:obj oldArea:u32 newArea:u32
    on_trade_init                       48  cancel     trader:obj tradee:obj
    on_send_mail                        49  cancel     sender:obj recipientGuid:obj
    on_quest_status_changed             54  broadcast  player:obj questId:u32 status:u32

category guild = 0x04
    on_add_member                        1  broadcast  guild:h.guild player:obj plRank:u32
    on_remove_member                     2  broadcast  guild:h.guild player:obj isDisbanding:bool
    on_motd_change                       3  broadcast  guild:h.guild motd:str
    on_info_change                       4  broadcast  guild:h.guild info:str
    on_create                            5  broadcast  player:obj
    on_disband                           6  broadcast  guild:h.guild
    on_money_withdraw                    7  broadcast  guild:h.guild player:obj amount:u32! isRepair:bool
    on_money_deposit                     8  broadcast  guild:h.guild player:obj amount:u32!
    on_item_move                         9  broadcast  guild:h.guild player:obj item:obj isSrcBank:bool srcContainer:u32 srcSlotId:u32 isDestBank:bool destContainer:u32 destSlotId:u32
