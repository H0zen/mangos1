category creature = 0x07
    on_enter_combat                      1  broadcast  player:obj enemy:obj
    on_leave_combat                      2  broadcast  player:obj
    on_target_died                       3  broadcast  creature:obj victim:obj
    on_died                              4  broadcast  creature:obj killer:obj
    on_spawn                             5  broadcast  gameobject:obj
    on_reach_wp                          6  broadcast  creature:obj type:u32 id:u32
    on_ai_update                         7  role       me:obj diff:u32
    on_receive_emote                     8  broadcast  creature:obj player:obj emoteId:u32
    on_damage_taken                      9  broadcast  creature:obj attacker:obj damage:u32!
    on_pre_combat                       10  broadcast  creature:obj target:obj
    on_owner_attacked                   12  broadcast  creature:obj target:obj
    on_owner_attacked_at                13  broadcast  creature:obj attacker:obj
    on_hit_by_spell                     14  broadcast  creature:obj caster:obj spell:h.spellinfo
    on_spell_hit_target                 15  broadcast  creature:obj target:obj spell:h.spellinfo
    on_just_summoned_creature           19  broadcast  creature:obj summon:obj
    on_summoned_creature_despawn        20  broadcast  creature:obj summon:obj
    on_summoned_creature_died           21  broadcast  creature:obj summon:obj killer:obj
    on_summoned                         22  cancel     creature:obj summoner:obj
    on_reset                            23  broadcast  creature:obj
    on_reach_home                       24  broadcast  creature:obj
    on_corpse_removed                   26  broadcast  creature:obj respawnDelay:u32!
    on_move_in_los                      27  broadcast  creature:obj who:obj
    on_dummy_effect                     30  claim      caster:obj spellId:u32 effIndex:enum target:obj
    on_quest_accept                     31  claim      player:obj item:obj quest:h.quest
    on_quest_reward                     34  claim      player:obj creature:obj quest:h.quest opt:u32
    on_dialog_status                    35  claim      player:obj creature:obj
    on_add                              36  broadcast  player:obj item:obj
    on_remove                           37  cancel     player:obj item:obj

category gameobject = 0x08
    on_ai_update                         1  role       me:obj diff:u32
    on_spawn                             2  broadcast  gameobject:obj
    on_dummy_effect                      3  claim      caster:obj spellId:u32 effIndex:enum target:obj
    on_quest_accept                      4  claim      player:obj item:obj quest:h.quest
    on_quest_reward                      5  claim      player:obj creature:obj quest:h.quest opt:u32
    on_dialog_status                     6  claim      player:obj gameobject:obj
    on_destroyed                         7  broadcast  gameObject:obj attacker:obj
    on_damaged                           8  broadcast  gameObject:obj attacker:obj
    on_loot_state_change                 9  broadcast  gameObject:obj state:u32
    on_go_state_changed                 10  broadcast  gameObject:obj state:u32
    on_add                              12  broadcast  player:obj item:obj
    on_remove                           13  cancel     player:obj item:obj
    on_use                              14  claim      player:obj item:obj targets:b.casttargets

category spell = 0x09
    on_cast                              1  broadcast  spell:b.spell skipCheck:bool
    on_aura_application                  2  cancel     aura:b.aura auraEff:b.auraeffect target:obj mode:u32 apply:bool
    on_dispel                            3  broadcast  aura:b.aura dispel:b.dispel
    on_periodic_tick                     4  cancel     aura:b.aura auraEff:b.auraeffect target:obj
    on_periodic_update                   5  broadcast  aura:b.aura auraEff:b.auraeffect
    on_aura_calc_amount                  6  broadcast  aura:b.aura auraEff:b.auraeffect amount:i32! canBeRecalculated:bool!
    on_calc_periodic                     7  broadcast  aura:b.aura auraEff:b.auraeffect isPeriodic:bool! amplitude:i32!
    on_check_proc                        8  cancel     aura:b.aura proc:b.proc
    on_proc                              9  cancel     aura:b.aura proc:b.proc
    on_check_cast                       10  broadcast  spell:b.spell
    on_before_cast                      11  broadcast  spell:b.spell
    on_after_cast                       12  broadcast  spell:b.spell
    on_object_area_target               13  broadcast  spell:b.spell effIndex:u32 targets:b.objlist
    on_object_target                    14  broadcast  spell:b.spell effIndex:u32 target:b.objslot
    on_dest_target                      15  broadcast  spell:b.spell effIndex:u32 dest:b.spelldest
    on_effect_launch                    16  cancel     spell:b.spell effIndex:u32 mode:u32 preventDefault:bool
    on_effect_launch_target             17  cancel     spell:b.spell effIndex:u32 mode:u32 preventDefault:bool
    on_effect_calc_absorb               18  broadcast  spell:b.spell damageInfo:b.damage resistAmount:u32! absorbAmount:i32!
    on_effect_hit                       19  cancel     spell:b.spell effIndex:u32 mode:u32 preventDefault:bool
    on_before_hit                       20  broadcast  spell:b.spell missInfo:u32
    on_effect_hit_target                21  cancel     spell:b.spell effIndex:u32 mode:u32 preventDefault:bool
    on_hit                              22  broadcast  spell:b.spell
    on_after_hit                        23  broadcast  spell:b.spell

category item = 0x0A
    on_dummy_effect                      1  claim      caster:obj spellId:u32 effIndex:enum target:obj
    on_use                               2  claim      player:obj item:obj targets:b.casttargets
    on_quest_accept                      3  claim      player:obj item:obj quest:h.quest
    on_expire                            4  cancel     player:obj proto:h.itemtpl
    on_remove                            5  cancel     player:obj item:obj
    on_add                               6  broadcast  player:obj item:obj
    on_equip                             7  broadcast  player:obj item:obj bag:u32 slot:u32
    on_unequip                           8  broadcast  player:obj item:obj slot:u32

category bg = 0x0C
    on_start                             1  broadcast  bg:h.bg bgId:u32 instanceId:u32
    on_end                               2  broadcast  bg:h.bg bgId:u32 instanceId:u32 winner:u32
    on_create                            3  broadcast  player:obj
    on_pre_destroy                       4  broadcast  bg:h.bg bgId:u32 instanceId:u32

category instance = 0x0D
    on_initialize                        1  role       ai:b.instanceai
    on_load                              2  role       ai:b.instanceai
    on_update                            3  role       -
    on_player_enter                      4  role       map:h.map player:obj
    on_creature_create                   5  role       ai:b.instanceai creature:obj
    on_gameobject_create                 6  role       ai:b.instanceai gameobject:obj
    on_check_encounter_in_progress       7  role       ai:b.instanceai

# Eluna numbers gossip by register type, so one id means four different
# events with four different payloads. The seam splits them, because an id
# must name one thing. The Eluna adapter maps these back to (regtype, 1|2);
# this is the one place the manifest deliberately leaves Eluna numbering.
category gossip = 0x0B
    creature_hello                       1  claim      player:obj creature:obj
    creature_select                      2  claim      player:obj creature:obj sender:u32 action:u32 code:str
    gameobject_hello                     3  claim      player:obj gameobject:obj
    gameobject_select                    4  claim      player:obj gameobject:obj sender:u32 action:u32 code:str
    item_hello                           5  claim      player:obj item:obj
    item_select                          6  claim      player:obj item:obj sender:u32 action:u32 code:str
    player_menu_select                   7  claim      player:obj menuId:u32 sender:u32 action:u32 code:str

# DBScripts. Fire-and-forget by construction: the engine queues commands on
# the map with a per-command delay and returns before any of them run, so it
# can never answer. All ten are broadcast, and that is a property of the
# engine, not a choice made here.
category dbscript = 0x0E
    on_quest_start                       0  broadcast  source:obj target:obj id:u32
    on_quest_end                         1  broadcast  source:obj target:obj id:u32
    on_gossip                            2  broadcast  source:obj target:obj id:u32
    on_creature_movement                 3  broadcast  source:obj target:obj id:u32
    on_creature_death                    4  broadcast  source:obj target:obj id:u32
    on_spell                             5  broadcast  source:obj target:obj id:u32
    on_go_use                            6  broadcast  source:obj target:obj id:u32
    on_got_use                           7  broadcast  source:obj target:obj id:u32
    on_event                             8  broadcast  source:obj target:obj id:u32
    on_creature_spell                    9  broadcast  source:obj target:obj id:u32

# The three SD3 entry points with no Eluna counterpart. Every other hook SD3
# exposes falls into a category above -- which is itself the finding: two
# engines have been maintaining near-identical surfaces side by side, each
# with its own gaps, for years.
category core = 0x0F
    on_npc_spell_click                   1  claim      player:obj creature:obj spellId:u32
    on_effect_script_effect              2  claim      caster:obj spellId:u32 effIndex:u32 target:obj originalCaster:obj
    on_aura_dummy                        3  claim      aura:b.aura apply:bool
