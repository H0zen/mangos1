    on_duel_end                         11  broadcast  winner:obj loser:obj type:enum
    on_give_xp                          12  broadcast  player:obj amount:u32! victim:obj
    on_level_change                     13  broadcast  player:obj oldLevel:u32
    on_money_change                     14  broadcast  player:obj amount:i32!
    on_reputation_change                15  broadcast  player:obj factionID:u32 standing:i32! incremental:bool
    on_talents_change                   16  broadcast  player:obj newPoints:u32
    on_talents_reset                    17  broadcast  player:obj noCost:bool
