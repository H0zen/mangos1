# Event manifest -- the single source of truth for the scripting seam.
#
# Generated from this file, never edited by hand:
#     ScriptEvents.gen.h    the EventId enum and one struct per event
#     events.d.lua          editor type stubs for script authors
#     doc/ScriptEvents.md   the reference table
#
# IDENTITY IS ABI. EventId = (category << 8) | local id, and the local ids below
# are Eluna's own numbers, unchanged, so every Lua script that registers by
# number keeps working across the move. Never renumber an entry: retire it and
# let the hole stand, the way Eluna's own gaps stand today.
#
# policy
#     broadcast   every engine sees it, nobody answers          -> Notify()
#     cancel      any engine may refuse the action              -> Ask()
#     claim       an engine states it produced the behaviour so
#                 the core skips its own default                -> Offer()
#     role        NOT an event. A callback on an object an engine won at
#                 auction (CreatureAI, InstanceData). Listed so this file is a
#                 complete census of the surface; excluded from dispatch,
#                 because routing a per-creature per-tick call through a global
#                 table would be both slower and semantically wrong.
#
# payload types
#     obj         entity named by an ObjectGuid, resolved through the world at
#                 the moment of use
#     h.<domain>  stable identity that is not a guid: guild, group, quest, map,
#                 bg, channel, auction, ahouse, itemtpl, spellinfo, areatrigger
#     b.<domain>  BORROW, valid only for the duration of the call. There is no
#                 identity to give -- a Spell in flight, an Aura, a WorldPacket.
#                 The engine receives an epoch-checked handle, so a script that
#                 stores one and touches it next tick fails loudly instead of
#                 dereferencing freed memory. This is the single largest
#                 correctness gap in the current engines: 10% of all payload
#                 arguments are raw pointers of exactly this kind.
#     u32 i32 u64 i64 f64 bool str enum
#     trailing !  in/out; an engine may write the slot back
#     ?           payload not yet transcribed. The identity on the line is
#                 final; only the argument list is outstanding.

category packet = 0x01
    on_receive                           5  cancel     player:obj packet:b.packet!
    on_receive_unk                       6  cancel     player:obj packet:b.packet!
    on_send                              7  cancel     player:obj packet:b.packet

category server = 0x02
    on_network_start                     1  broadcast  -   # id reserved; this core never fires it
    on_network_stop                      2  broadcast  -   # id reserved; this core never fires it
    on_socket_open                       3  broadcast  -   # id reserved; this core never fires it
    on_socket_close                      4  broadcast  -   # id reserved; this core never fires it
    on_packet_receive                    5  cancel     session:b.session packet:b.packet!
    on_packet_receive_unk                6  cancel     player:obj packet:b.packet!
    on_packet_send                       7  cancel     session:b.session packet:b.packet
    on_open_state_change                 8  broadcast  open:bool
    on_config_load                       9  broadcast  reload:bool
    on_shutdown_init                    11  broadcast  code:u32 mask:u32
    on_shutdown_cancel                  12  broadcast  -
    on_world_update                     13  broadcast  diff:u32
    on_world_startup                    14  broadcast  -
    on_world_shutdown                   15  broadcast  -
    on_lua_state_close                  16  broadcast  -
    on_map_create                       17  broadcast  map:h.map
    on_map_destroy                      18  broadcast  map:h.map
    on_map_grid_load                    19  broadcast  -   # id reserved; this core never fires it
    on_map_grid_unload                  20  broadcast  -   # id reserved; this core never fires it
    on_map_player_enter                 21  broadcast  map:h.map player:obj
    on_map_player_leave                 22  broadcast  map:h.map player:obj
    on_map_update                       23  broadcast  map:h.map diff:u32
    on_event_trigger                    24  claim      player:obj trigger:h.areatrigger
    on_weather_change                   25  broadcast  weather:h.weather zone:u32 state:u32 grade:f64
    on_auction_add                      26  broadcast  house:h.ahouse entry:h.auction
    on_auction_remove                   27  broadcast  house:h.ahouse entry:h.auction
    on_auction_successful               28  broadcast  house:h.ahouse entry:h.auction
    on_auction_expire                   29  broadcast  house:h.ahouse entry:h.auction
    on_addon_message                    30  cancel     sender:obj type:u32 msg:str! receiver:obj guild:h.guild group:h.group channel:h.channel
    on_world_delete_creature            31  broadcast  creature:obj
    on_world_delete_gameobject          32  broadcast  gameobject:obj
    on_lua_state_open                   33  broadcast  -
    on_game_start                       34  broadcast  eventId:u32
    on_game_stop                        35  broadcast  eventId:u32

