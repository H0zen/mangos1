category vehicle = 0x06
    on_install                           1  broadcast  vehicle:enum
    on_uninstall                         2  broadcast  vehicle:enum
    on_install_accessory                 4  broadcast  vehicle:enum accessory:obj
    on_add_passenger                     5  broadcast  vehicle:enum passenger:obj seatId:i32
