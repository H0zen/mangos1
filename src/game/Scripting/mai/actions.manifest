# MAI action manifest -- the verbs a script can use, declared once.
#
# Generated from this file, never edited by hand:
#     MaiActions.gen.h    the ActionId enum, the parameter tables, the accessors
#     actions.md          the reference an author reads
#
# WHY THIS FILE EXISTS AT ALL. The DB scripts already had a data-driven action
# set -- 47 commands with a tagged union of parameters -- and it worked. What it
# did not have was a way to say what a parameter MEANS. Every one of them is a
# `datalong`, so `cast_spell` and `play_sound` take the same type, and a typo
# that puts a sound id where a spell id belongs loads without complaint and
# fails silently at run time, once, in front of a player.
#
# Here a parameter has a semantic type. `spell` is checked against the spell
# store when the script loads, `creature` against the creature templates,
# `text` against the text tables. A script that names something that does not
# exist is refused at load with the line that names it -- which is what EventAI
# already does for its own tables, and the single largest reason to keep this
# as data rather than move it into a general-purpose language.
#
# IDENTITY IS ABI. The ids below are the DB-script command numbers, unchanged,
# so an existing `dbscripts_on_*` row lowers to the same verb by number and the
# migration is mechanical. Holes are retired commands; never fill one in.
#
# types
#     u32 i32 f32 bool          plain values
#     ms                        a duration in milliseconds
#     spell creature gameobject validated against the world's own tables, at
#     item quest faction map    load, so a wrong id is a load error and not a
#     emote sound movie taxi    silent no-op at run time
#     mail area text
#     field                     an update-field index; bounded by the object
#     flags                     a bitmask, printed in hex
#     trailing ?                optional; absent means the action's own default
#
# Every action also carries the three facets every DB-script row carried, and
# they are declared once here rather than repeated per verb:
#
#     texts       up to four text ids, because TALK picks one at random
#     at          a position, for the verbs that need one
#
# And one that only the casting verbs carry:
#
#     points      base points computed when the spell is cast, rather than the
#                 fixed ones the spell carries. A proc that deals "15% of the
#                 damage that triggered it" has no number to write down until
#                 the moment it fires: the number is
#
#                     source * percent / 100 / divisor
#
#                 where `points_source` names what to read, `points_scale`
#                 says where the percentage itself comes from -- the row, the
#                 aura's own amount, or a second effect of the aura spell --
#                 and the arithmetic is in combat/pure/ProcPoints.h, where it
#                 is tested without a world.
#
#                 Absent means the spell keeps its own base points.
#
# The buddy search is NOT among them, and that is a correction rather than an
# omission. In `dbscripts_on_*` it is a property of the ROW, not of the
# command: any command at all may be redirected to act on some other creature
# found nearby. That makes it a property of a step, like the time, and it
# lives on Step in MaiScript.h -- putting it here would have declared it 47
# times and still been wrong about what it modifies.

facet texts   text0:text? text1:text? text2:text? text3:text?
facet at      x:f32? y:f32? z:f32? o:f32?
facet points  points_source:points_source? points_scale:points_scale? \
              points_coeff:i32? points_divisor:u32?

category say = 0x01
    talk                     0   texts
    emote                    1   emote:emote
    play_sound              16   sound:sound flags:flags?
    play_movie              19   movie:movie

category field = 0x02
    field_set                2   field:field value:u32
    flag_set                 4   field:field value:flags
    flag_remove              5   field:field value:flags
    morph_to_entry_or_model 23   entry:u32
    mount_to_entry_or_model 24   entry:u32
    change_entry            39   entry:creature
    # `faction` here is NOT a faction. The body reads it as
    # `faction ? HORDE : ALLIANCE` -- one bit, which team the new template
    # belongs to -- and the column keeps the name it had in `datalong2`.
    # Typed as a faction it refused every alliance-side row in the world for
    # naming faction 0, and every horde-side one written as -1 for naming
    # faction 4294967295.
    update_template         44   entry:creature faction:bool
    set_equipment_slots     42   reset_default:bool
    modify_npc_flags        29   flag:flags change:u32
    # OPTIONAL because 0 is a real instruction: it clears the temporary
    # faction and puts the creature back to its own. Required, it read as
    # "faction 0", which no world has.
    set_faction             22   faction:faction? flags:flags?

category move = 0x03
    move_to                  3   speed:u32? scatter:f32? at
    teleport_to              6   map:map at
    movement                20   type:u32 wander_distance:u32?
    set_run                 25   run:bool
    turn_to                 36   target:u32
    move_dynamic            37   max_dist:f32 min_dist:f32?

    # The missing member of the family above. MAI could teleport to a PLACE
    # (teleport_to) and walk to a UNIT (move_dynamic with max_dist 0), and had
    # no way to arrive at a unit instantly -- which is what every blink,
    # charge and gate does. Written as a verb rather than as a spell's private
    # hack, because it is not one boss's trick.
    teleport_to_target      129

    # Follow the step's target, without attacking it. `attack_start` makes a
    # creature fight what it is chasing, which is a different instruction and
    # the wrong one for anything that is not supposed to swing: Sepethrea's
    # Raging Flames are immune to all damage and exist only to be run away
    # from.
    chase                   134   distance:f32? angle:f32?

    # Follow, which is not chase. MoveChase keeps a fighting distance and turns
    # to face; MoveFollow walks at a fixed bearing behind somebody and is what
    # every charmed critter, escort and pet does. The four numbers are RANGES
    # because the scripts that want this want a crowd that does not stack: the
    # Deeprun rats each pick their own distance and angle, so ten of them
    # behind one player look like ten rats and not like one.
    follow                  143   min_distance:f32? max_distance:f32?                                   min_angle:f32? max_angle:f32?
    send_taxi_path          30   path:taxi
    pause_waypoints         32   pause:bool
    set_fly                 59   enable:bool
    stand_state             28   state:u32

category combat = 0x04
    # `credit_owner` casts the spell as though the creature whose RULE this is
    # had cast it -- which is not the same as casting it. Broggok's poison
    # clouds cast their aura on themselves and the damage is attributed to
    # Broggok, so it is his kill and his threat; without it the cloud is
    # credited and the boss is not.
    #
    # 34 places in ScriptDev pass an original caster, and DoCastSpellIfCan has
    # always taken the argument. MAI simply never gave it one.
    #
    # `stop_if_refused` ends the SEQUENCE when the cast did not go ahead, which
    # is what ScriptDev writes as
    #
    #     if (DoCastSpellIfCan(...) == CAST_OK) { DoScriptText(...); }
    #
    # everywhere an ability announces itself. Without it the boss says his line
    # and does nothing, once per attempt, which is worse than silence: the raid
    # is told to move out of something that is not there.
    cast_spell              15   spell:spell flags:flags? credit_owner:bool? \
                                 stop_if_refused:bool? points
    remove_aura             14   spell:spell

    # ONE STACK, where remove_aura takes the whole holder. A different
    # instruction rather than a shade of the same one: Unstable Power is a
    # buff that spends a charge each time it works, and told to remove the
    # aura it would spend all of them at once.
    #
    # Not a parameter of remove_aura, because a `count` on the verb that
    # removes everything would have to mean "unless" -- and a converted row
    # with no count would then mean "all", which is the answer that verb
    # already gives.
    remove_aura_stack       159   spell:spell count:u32?
    attack_start            26
    despawn_self            18   delay:ms?
    respawn                 41

    # The source kills the target outright, and the CREDIT is what this is for:
    # damage dealt by somebody is a kill by somebody, with experience, loot and
    # a quest tick. `die` is the other half -- the target simply dies, with no
    # killer and so no reward -- and a script that means one and writes the
    # other is the difference between a quest that completes and one that does
    # not.
    kill_target             139

category world = 0x05
    respawn_go               9   guid:u32 despawn_delay:ms?
    despawn_go              40   guid:u32 respawn_time:ms?
    open_door               11   guid:u32 reset_delay:ms?

    # Open or close whichever door or button the step is acting on -- found by
    # the buddy search rather than named by guid, which is the difference from
    # `open_door` above and the reason both exist. A waterfall that parts when
    # somebody walks up to it is one of thirty-five yards, not one guid.
    #
    # Only if it is READY: an object already in use is mid-animation, and
    # using it again is what makes a door stutter.
    use_door                150   reset_delay:ms?
    close_door              12   guid:u32 reset_delay:ms?
    activate_object         13
    reset_go                43
    go_lock_state           27   state:flags
    # `scatter` puts it at a random point on the ground within that many
    # yards of the position, which is RandomGroundPointNear -- what every
    # script does that spawns three of something and does not want them
    # standing inside each other.
    temp_summon_creature    10   entry:creature despawn_delay:ms?                                  scatter:f32? at

    # At the step's TARGET rather than at a written position. The missing
    # member of the summon family, exactly as teleport_to_target was of the
    # movement one: MAI could summon at a PLACE and had no way to summon at a
    # unit, which is what every "it appears under them" does.
    #
    # `mode` is TempSpawnType, written down rather than guessed: a summon that
    # despawns on a timer, one that waits until its summoner leaves combat and
    # one that lingers as a corpse are three different things, and the default
    # -- timed when a delay is given, dead-despawn when it is not -- is what
    # every converted row already means.
    #
    # `attack` points the new creature at whoever SUMMONED it, which is what
    # "and it comes up angry" is in every script that has one. `face` is the
    # half of that without the fight: turned towards its summoner and doing
    # nothing about it, which is what an Ethereum prisoner does when the
    # prison opens.
    #
    # The `at` facet is an OFFSET here, not a place: the point of this verb is
    # that the place is not known until it runs. `o` is the exception and is
    # absolute -- there is no orientation to offset from -- and it loses to
    # `face` when both are written.
    #
    # `face` is a small enum rather than a flag, because "which way is it
    # looking" has three answers and only one of them is a number:
    #   1  towards whoever summoned it
    #   2  the same way as the thing it appeared at
    # absent, or 0, means the `o` of the position facet -- zero by default,
    # which is what every converted row already means.
    summon_at_target        133   entry:creature despawn_delay:ms? mode:u32?                                   attack:bool? face:u32? at
    set_activeobject        21   activate:bool

    # Take a gameobject that is standing there ready, and use it up: it must
    # exist, and its respawn timer must be zero -- an object already taken is
    # waiting to come back and must not be taken twice. Found as the step's
    # TARGET when no range is given, or as the nearest one of that entry within
    # `range` of the target when there is.
    #
    # The check and the taking are ONE verb on purpose. Every script that does
    # this reads "if it is there and nobody has it, it is mine", and splitting
    # that in two is two searches and a window between them.
    consume_go              138   entry:gameobject range:f32?

category player = 0x06
    quest_explored           7   quest:quest distance:f32?
    # OPTIONAL for the same reason as set_faction: 0 means "credit whichever
    # end of this step is the creature", which is how a script gives credit
    # for a kill it did not name in advance.
    kill_credit              8   entry:creature? group_credit:bool?
    create_item             17   item:item amount:u32?
    send_mail               38   template:mail alt_sender:creature?
    join_lfg                33   area:area
    xp_user                 53   flags:flags

category flow = 0x07
    # The two that end a running sequence rather than doing something in the
    # world. terminate_script stops when a named creature is (or is not) found
    # nearby; terminate_cond stops on a condition, and may fail a quest as it
    # goes.
    terminate_script        31   entry:creature? search_dist:f32?
    terminate_cond          34   condition:u32 fail_quest:quest?

    # Stop unless the step's TARGET is this creature. `terminate_script` asks
    # whether one is NEARBY, which is a different question and the wrong one
    # for a spell: a sequence started by a dummy effect knows exactly who was
    # hit, and usually only means to act if it was the right sort of thing.
    #
    # Needed wherever a spell has no `spell_script_target` row to narrow it --
    # where it does, the restriction is already enforced and this is a
    # duplicate.
    #
    # Up to four entries, because "a sickly deer or a sickly gazelle" is one
    # question and not two: the alternative is a branch per entry, and a branch
    # per entry for a list is how a four-line switch becomes eight tables.
    require_target          135   entry:creature entry2:creature?                                   entry3:creature? entry4:creature?

    # Stop unless the step's target is (or is not) fighting somebody. The
    # difference decides whether a creature killed by a script gives credit:
    # Gordawg's boulder kills a minion outright when it was in combat and lets
    # it die unrewarded when it was not.
    require_victim          140   present:bool?

    # Stop unless the step's target's health is inside the band. Both ends are
    # optional and both are percentages of ITS OWN maximum, so a script says
    # "nearly dead" and stays right when the template changes underneath it.
    require_health          141   max_percent:u32? min_percent:u32?

    # Stop unless the step's target is standing/sitting/kneeling as named.
    # UnitStandStateType: 0 stands, 8 kneels.
    require_stand_state     142   state:u32

    # Stop unless a creature of `entry` is (or is not) within `range` of the
    # step's target. Its OWN search rather than the step's buddy, and that is
    # the point: a buddy that is not there SKIPS the step, so a buddy can
    # never answer "is there one?". This verb can.
    # `alive` is three-valued and the C++ is why: GetClosestCreatureWithEntry
    # takes onlyAlive and onlyDead as two booleans, and the Larkorwi and
    # Murkdeep triggers pass FALSE to both -- "is there one at all, alive or a
    # corpse". Absent means alive only, which is what every other caller wants;
    # 0 means dead only; 2 means either.
    require_creature        145   entry:creature range:f32 present:bool?                                   alive:u32?

    # Stop unless the step's SOURCE is (or is not) a temporary summon. The
    # difference between the three Greymist Coastrunners a quest put on the
    # beach and the ones that live there: only the summoned ones run to the
    # water, and only their deaths are counted.
    require_summoned        149   present:bool?

    # Stop unless the player passes every one of these. Each is checked only
    # when it is written, so a step names the two it cares about and says
    # nothing about the rest.
    #
    # ONE VERB RATHER THAN FIVE, and that is the shape of the question rather
    # than a saving: ScriptDev asks these in clusters and almost never singly.
    #
    #     if (pPlayer->IsAlive() && !pPlayer->isGameMaster() && ...)
    #     if (pPlayer->IsAlive() && !pPlayer->IsInCombat())
    #
    # None of the five has a `conditions` type behind it -- zone, skill,
    # quest, reputation and team all do, which is why those stay in that table
    # and these do not.
    #
    # `minipet` is an entry rather than a flag: Children's Week asks WHICH
    # orphan is following you, not whether one is.
    require_player          147   alive:bool? in_combat:bool? gm:bool?                                   taxi:bool? minipet:creature?

    # ---- saying no --------------------------------------------------------
    #
    # REFUSING is not doing, and it is the whole of what an ItemScript was for:
    # every one of them checked something and then blocked the item's own
    # spell. The verb ends the sequence AND tells the seam to cancel, which is
    # why it can only appear in a kind that runs inline -- an answer that
    # arrives on the next map tick is not an answer.
    #
    #   equip_error   an InventoryResult, sent as an equip error. ZERO --
    #                 EQUIP_ERR_NONE -- is a real value here and not an
    #                 absence: it is what unsticks the item on the cursor,
    #                 which is why three of the four scripts send it.
    #   cast_result   a SpellCastResult, sent as the failure the player sees.
    #   spell         which spell the failure is about. Defaults to the
    #                 item's own first spell, which is what it always is.
    refuse_use              146   equip_error:u32? cast_result:u32? spell:spell?

    # "This sequence produced the behaviour; the core need look no further."
    # The same channel `refuse_use` uses and the opposite meaning: one says the
    # thing must not happen, the other says it already has.
    #
    # An area trigger is where it matters. A claimed one skips the quest credit
    # the trigger would otherwise give, the tavern rest, the battleground
    # handling and the teleport -- so `return true` in an AreaTriggerScript is
    # a decision about four other systems, and every one of the six live
    # scripts makes it differently on different paths.
    claim                   151

    # ---- the branch -------------------------------------------------------
    #
    # A sequence is a straight line, and a straight line cannot say "one of
    # these". EventAI faked it with three action columns and a flag; the DB
    # scripts could not say it at all. Both of these start ANOTHER sequence,
    # with this step's source and target, and the sub-sequence stops itself on
    # its own `require_*` -- which is what makes a branch a branch: the parent
    # keeps going either way.
    #
    # `kind` defaults to `branch` (12), the kind that exists for exactly this
    # and whose ids are nobody else's.
    start_script            136   kind:u32? script:u32

    # Exactly ONE of up to three, uniformly. Repeating an id is how a script
    # says two-in-three: `a=7 b=7 c=8` is the shape every `urand(0, 2)` in
    # ScriptDev has, written down.
    #
    # `first`/`count` is the same verb for a longer list: one of `count`
    # branches numbered from `first`. Thirteen Ethereum prisoners are two
    # numbers rather than thirteen columns, and the ids being contiguous is
    # the price -- which for a set of branches written together is no price at
    # all.
    random_script           137   a:u32? b:u32? c:u32?                                   first:u32? count:u32?
    send_ai_event_around    35   event:u32 radius:f32

# ---------------------------------------------------------------------------
# What EventAI could say and the DB scripts could not.
#
# The two action sets overlap by more than half -- both cast, both talk, both
# morph, both change faction -- and where they agree they use the SAME verb
# here. An EventAI row converts by naming a verb, not by number, so there is no
# collision with the DB-script ids above and no second vocabulary to learn.
#
# What follows is only the difference: the things a creature's AI needs and a
# queued command list never did. Numbering continues from 0x60 so the origin of
# a verb is visible in its id.
# ---------------------------------------------------------------------------

category threat = 0x10
    threat_change            96   percent:i32 all:bool?
    call_for_help            97   radius:f32
    flee_for_assist          98
    zone_combat_pulse        99

category ai = 0x11
    # Phases are EventAI's whole notion of state: a bitmask a rule can be
    # restricted to. They become named states in due course; converted
    # faithfully first, so the conversion can be checked before it is improved.
    set_phase               100   phase:u32
    inc_phase               101   by:i32
    random_phase            102   a:u32 b:u32? c:u32?
    auto_attack             103   enable:bool
    combat_movement         104   enable:bool melee:bool?
    ranged_movement         105   distance:f32 angle:f32?
    change_movement         106   type:u32 wander_distance:f32?
    evade                   107
    # `silent` is death with no killer: the creature is simply not alive any
    # more. Nothing procs, nothing is credited, nothing drops -- which is what
    # a script means when it kills something the player did not fight. Without
    # it the creature damages itself to death, and a self-kill is still a
    # death event with everything that hangs off one.
    die                     108   silent:bool?
    set_invincibility       109   hp:u32 percent:bool?

    # Out of 100, because a script that heals says "to full" and never "to
    # 43,891". The absolute number is the one thing a creature's own template
    # already knows.
    set_health              128   percent:u32
    throw_ai_event          110   event:u32 radius:f32?

    # To ONE creature -- whoever the step's buddy search picked -- rather than
    # to everyone in a radius. `throw_ai_event` shouts; this one speaks. Garr
    # telling a single add to detonate is not the same instruction as telling
    # every add within thirty yards to detonate, and only one of those is a
    # fight.
    #
    # The value is the event's own payload: the receiving rule can be written
    # against it, so "explode with THIS spell" is a number the sender chooses
    # rather than something the receiver has to guess.
    send_ai_event           130   event:u32 value:u32?
    set_throw_mask          111   mask:flags

# The randomness EventAI expressed by having three columns. `talk` needed no
# verb of its own because a text id is already four-wide -- picking one of four
# IS what the facet is for -- but a sound and an emote are single values, so
# choosing between three of them is a different verb rather than a wider one.
category random = 0x15
    random_sound            122   a:sound b:sound? c:sound?
    random_emote            123   a:emote b:emote? c:emote?

    # A phase from a RANGE, which `random_phase` cannot say: it picks from a
    # list of up to three, and "somewhere between 1 and 16" is not a list.
    random_phase_range      124   min:u32 max:u32

# What a creature remembers, and the other half of a decision: a guard reads
# these, and these are the only things that write them. Named, not numbered --
# `set_state name=enraged value=1` says what `datalong3 = 1` never could, and
# the name is interned to a slot when the creature's rules load.
category memory = 0x16
    set_state               126   name:state value:u32

    # Set one of THIS creature's rules to fire in `ms`, or stop it firing at
    # all. The other half of a deadline: something is given one, something else
    # makes it moot, and whichever happens first must stop the other.
    #
    # Taerar is why. He banishes himself and summons three shades; sixty
    # seconds later he returns, UNLESS the shades die first, in which case he
    # returns at once. Written as a delayed step the sixty-second half survives
    # the shades' death and cuts the NEXT banish short; written as a guarded
    # rule the timer freezes half-counted instead of resetting. Both are wrong
    # by twenty seconds in a fight that lasts three minutes.
    #
    # `enable=0` disarms the rule outright and `ms` is then ignored.
    set_timer               148   rule:u32 ms:ms? enable:bool?

    # Remember WHOM the step is acting on, so later steps can act on the same
    # one. The other half of `select=11`, and the reason a focus, a mark and a
    # chain are expressible at all: they are all "pick one, then keep meaning
    # that one".
    remember_target         132
    add_state               127   name:state by:i32

category instance = 0x12
    set_instance_data       112   field:u32 value:u32

    # The value is WHO, not a number: it stores the target's guid, which is not
    # known until the step runs. That is why it cannot be set_instance_data64
    # with two literal halves, and why it takes no value at all.
    set_instance_data_guid  125   field:u32
    # Two halves, not a u64: an operand is one 32-bit cell, and widening every
    # one of them for the single verb that wants eight bytes -- a verb the live
    # world calls zero times -- is the wrong trade.
    set_instance_data64     113   field:u32 low:u32 high:u32?

category unit = 0x13
    set_unit_field          114   field:field value:u32
    set_unit_flag           115   value:flags
    remove_unit_flag        116   value:flags
    set_sheath              117   state:u32

    # Make the step's subject immune to something, or stop being. `kind` is
    # SharedDefines.h's SpellImmunity -- 3 is damage of a school, 2 is the
    # school itself, 5 is a mechanic -- and `value` is whatever enum that kind
    # indexes.
    #
    # Two enums in two columns rather than one verb per kind, because the six
    # kinds are the same operation on six different vocabularies, and a verb
    # each would be six names for ApplySpellImmune.
    set_immunity            131   kind:u32 value:flags apply:bool?
    emote_target            118   emote:emote

    # A creature's own m_AuraFlags, which is not an update field and so cannot
    # be reached by set_unit_flag. One bit is defined -- UNIT_AURAFLAG_ALIVE_
    # INVISIBLE, 0x01 -- and it is what lets a ghost stand in the world visible
    # only to whoever is meant to see it.
    set_aura_flags          144   value:flags apply:bool?

category quest = 0x14
    quest_event             119   quest:quest all:bool?
    cast_event              120   creature:creature spell:spell all:bool?
    killed_monster          121   creature:creature

# The other two structures of a program, and nothing beyond them.
#
# A sequence was already the first: steps in order, each with a time. What the
# table had no way to say was selection and iteration -- and it was faking both
# in six different columns. `chance` is a probabilistic `if`; `select_else` is
# an if-else about a target; the `random_step` flag is a switch; `retry` is a
# do-while; and a sequence that starts itself is a loop with no exit. Six
# decisions, six meanings to remember, none of them nameable in the row that
# uses them.
#
# These seven are those two structures written once. They take no parameters
# to speak of, because the CONDITION is not a parameter of the verb: it goes in
# the row's `guard` column, in the same language a rule's guard has always been
# written in -- `phase=2 enraged=0`, one comparison against one remembered
# number, all of them holding.
#
# WHAT HAPPENS TO THEM. Nothing here reaches the world. MaiCompile resolves
# every one of them into a jump before the script is ever run, refuses a script
# whose blocks do not balance, and the runner walks the jumps -- so a branch
# costs an index and cannot be got wrong at run time, and a mismatched `end` is
# a load error naming the row rather than a creature standing still on a live
# server.
#
# NO CALL, NO RETURN, NO EXPRESSION, NO `or`. The line MaiScript.h has drawn
# from the first commit is unchanged: when an encounter needs more than
# sequence, selection and iteration over the verbs above, it is a program and
# belongs in C++. Moving that line once, deliberately, is the opposite of
# eroding it one operator at a time.
category control = 0x17
    # Run what follows only while the row's `guard` holds. `else` is optional
    # and there is no `else if`: nest a second `if`, which is what an `else if`
    # is anyway and reads the same in a table.
    if                      152
    else                    153

    # Closes whichever block is open -- an `if`, a `repeat` or a `while`. One
    # word rather than three, because the compiler has the stack and an author
    # counting `end_if` against `end_loop` is an author being asked to do the
    # compiler's job.
    #
    # ON A LOOP, ITS `at_ms` IS THE PERIOD OF ONE TURN. That is the whole of
    # how a loop is timed: the clock is rewound by `end`'s time less the body's
    # first, so what an author writes is one turn and what runs is that turn
    # repeated. `repeat times=3` with the body at 0 and the `end` at 1000 is
    # three casts a second apart.
    end                     154

    # A bounded loop, and the one to reach for. `times` is a number the row
    # states, so how long the loop can run is known when it LOADS -- which is
    # the property that lets a script still be printed without being run.
    repeat                  155   times:u32

    # An unbounded one, for when the number is not knowable: "while anything of
    # mine is still alive". Bounded by its guard and by nothing else, which is
    # why the fuel in MaiRunner exists: a `while` whose body takes no time and
    # whose guard never turns false cannot be told apart at load from the same
    # loop over a guard the body is about to change, so it is not refused --
    # it is capped per tick and reported.
    while                   156

    # Out of the innermost loop, and back to the top of it. Both take a guard,
    # which is the one-line form: `break` guarded by `adds=0` is what would
    # otherwise be an `if` block wrapped round it.
    break                   157
    continue                158
