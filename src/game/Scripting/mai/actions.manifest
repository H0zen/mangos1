# MAI action manifest -- the verbs a script can use, declared once.
#
# Generated from this file, never edited by hand:
#     MaiActions.gen.h    the ActionId enum, the parameter tables, the accessors
#     actions.md          the reference an author reads
#
# WHY THIS FILE EXISTS AT ALL. The DB scripts already had a data-driven action
# set -- 47 commands with a tagged union of parameters -- and it worked. What it
# did not have was a way to say what a parameter MEANS. Every one of them is a
# `datalong`, so `cast_spell` and `play_sound` take the same type, and a typo
# that puts a sound id where a spell id belongs loads without complaint and
# fails silently at run time, once, in front of a player.
#
# Here a parameter has a semantic type. `spell` is checked against the spell
# store when the script loads, `creature` against the creature templates,
# `text` against the text tables. A script that names something that does not
# exist is refused at load with the line that names it -- which is what EventAI
# already does for its own tables, and the single largest reason to keep this
# as data rather than move it into a general-purpose language.
#
# IDENTITY IS ABI. The ids below are the DB-script command numbers, unchanged,
# so an existing `dbscripts_on_*` row lowers to the same verb by number and the
# migration is mechanical. Holes are retired commands; never fill one in.
#
# types
#     u32 i32 f32 bool          plain values
#     ms                        a duration in milliseconds
#     spell creature gameobject validated against the world's own tables, at
#     item quest faction map    load, so a wrong id is a load error and not a
#     emote sound movie taxi    silent no-op at run time
#     mail area text
#     field                     an update-field index; bounded by the object
#     flags                     a bitmask, printed in hex
#     trailing ?                optional; absent means the action's own default
#
# Every action also carries the three facets every DB-script row carried, and
# they are declared once here rather than repeated per verb:
#
#     texts       up to four text ids, because TALK picks one at random
#     at          a position, for the verbs that need one
#
# The buddy search is NOT among them, and that is a correction rather than an
# omission. In `dbscripts_on_*` it is a property of the ROW, not of the
# command: any command at all may be redirected to act on some other creature
# found nearby. That makes it a property of a step, like the time, and it
# lives on Step in MaiScript.h -- putting it here would have declared it 47
# times and still been wrong about what it modifies.

facet texts   text0:text? text1:text? text2:text? text3:text?
facet at      x:f32? y:f32? z:f32? o:f32?

category say = 0x01
    talk                     0   texts
    emote                    1   emote:emote
    play_sound              16   sound:sound flags:flags?
    play_movie              19   movie:movie

category field = 0x02
    field_set                2   field:field value:u32
    flag_set                 4   field:field value:flags
    flag_remove              5   field:field value:flags
    morph_to_entry_or_model 23   entry:u32
    mount_to_entry_or_model 24   entry:u32
    change_entry            39   entry:creature
    update_template         44   entry:creature faction:faction
    set_equipment_slots     42   reset_default:bool
    modify_npc_flags        29   flag:flags change:u32
    set_faction             22   faction:faction flags:flags?

category move = 0x03
    move_to                  3   speed:u32? at
    teleport_to              6   map:map at
    movement                20   type:u32 wander_distance:u32?
    set_run                 25   run:bool
    turn_to                 36   target:u32
    move_dynamic            37   max_dist:f32 min_dist:f32?

    # The missing member of the family above. MAI could teleport to a PLACE
    # (teleport_to) and walk to a UNIT (move_dynamic with max_dist 0), and had
    # no way to arrive at a unit instantly -- which is what every blink,
    # charge and gate does. Written as a verb rather than as a spell's private
    # hack, because it is not one boss's trick.
    teleport_to_target      129
    send_taxi_path          30   path:taxi
    pause_waypoints         32   pause:bool
    set_fly                 59   enable:bool
    stand_state             28   state:u32

category combat = 0x04
    cast_spell              15   spell:spell flags:flags?
    remove_aura             14   spell:spell
    attack_start            26
    despawn_self            18   delay:ms?
    respawn                 41

category world = 0x05
    respawn_go               9   guid:u32 despawn_delay:ms?
    despawn_go              40   guid:u32 respawn_time:ms?
    open_door               11   guid:u32 reset_delay:ms?
    close_door              12   guid:u32 reset_delay:ms?
    activate_object         13
    reset_go                43
    go_lock_state           27   state:flags
    temp_summon_creature    10   entry:creature despawn_delay:ms? at

    # At the step's TARGET rather than at a written position. The missing
    # member of the summon family, exactly as teleport_to_target was of the
    # movement one: MAI could summon at a PLACE and had no way to summon at a
    # unit, which is what every "it appears under them" does.
    summon_at_target        133   entry:creature despawn_delay:ms?
    set_activeobject        21   activate:bool

category player = 0x06
    quest_explored           7   quest:quest distance:f32?
    kill_credit              8   entry:creature group_credit:bool?
    create_item             17   item:item amount:u32?
    send_mail               38   template:mail alt_sender:creature?
    join_lfg                33   area:area
    xp_user                 53   flags:flags

category flow = 0x07
    # The two that end a running sequence rather than doing something in the
    # world. terminate_script stops when a named creature is (or is not) found
    # nearby; terminate_cond stops on a condition, and may fail a quest as it
    # goes.
    terminate_script        31   entry:creature? search_dist:f32?
    terminate_cond          34   condition:u32 fail_quest:quest?
    send_ai_event_around    35   event:u32 radius:f32

# ---------------------------------------------------------------------------
# What EventAI could say and the DB scripts could not.
#
# The two action sets overlap by more than half -- both cast, both talk, both
# morph, both change faction -- and where they agree they use the SAME verb
# here. An EventAI row converts by naming a verb, not by number, so there is no
# collision with the DB-script ids above and no second vocabulary to learn.
#
# What follows is only the difference: the things a creature's AI needs and a
# queued command list never did. Numbering continues from 0x60 so the origin of
# a verb is visible in its id.
# ---------------------------------------------------------------------------

category threat = 0x10
    threat_change            96   percent:i32 all:bool?
    call_for_help            97   radius:f32
    flee_for_assist          98
    zone_combat_pulse        99

category ai = 0x11
    # Phases are EventAI's whole notion of state: a bitmask a rule can be
    # restricted to. They become named states in due course; converted
    # faithfully first, so the conversion can be checked before it is improved.
    set_phase               100   phase:u32
    inc_phase               101   by:i32
    random_phase            102   a:u32 b:u32? c:u32?
    auto_attack             103   enable:bool
    combat_movement         104   enable:bool melee:bool?
    ranged_movement         105   distance:f32 angle:f32?
    change_movement         106   type:u32 wander_distance:f32?
    evade                   107
    die                     108
    set_invincibility       109   hp:u32 percent:bool?

    # Out of 100, because a script that heals says "to full" and never "to
    # 43,891". The absolute number is the one thing a creature's own template
    # already knows.
    set_health              128   percent:u32
    throw_ai_event          110   event:u32 radius:f32?

    # To ONE creature -- whoever the step's buddy search picked -- rather than
    # to everyone in a radius. `throw_ai_event` shouts; this one speaks. Garr
    # telling a single add to detonate is not the same instruction as telling
    # every add within thirty yards to detonate, and only one of those is a
    # fight.
    #
    # The value is the event's own payload: the receiving rule can be written
    # against it, so "explode with THIS spell" is a number the sender chooses
    # rather than something the receiver has to guess.
    send_ai_event           130   event:u32 value:u32?
    set_throw_mask          111   mask:flags

# The randomness EventAI expressed by having three columns. `talk` needed no
# verb of its own because a text id is already four-wide -- picking one of four
# IS what the facet is for -- but a sound and an emote are single values, so
# choosing between three of them is a different verb rather than a wider one.
category random = 0x15
    random_sound            122   a:sound b:sound? c:sound?
    random_emote            123   a:emote b:emote? c:emote?

    # A phase from a RANGE, which `random_phase` cannot say: it picks from a
    # list of up to three, and "somewhere between 1 and 16" is not a list.
    random_phase_range      124   min:u32 max:u32

# What a creature remembers, and the other half of a decision: a guard reads
# these, and these are the only things that write them. Named, not numbered --
# `set_state name=enraged value=1` says what `datalong3 = 1` never could, and
# the name is interned to a slot when the creature's rules load.
category memory = 0x16
    set_state               126   name:state value:u32

    # Remember WHOM the step is acting on, so later steps can act on the same
    # one. The other half of `select=11`, and the reason a focus, a mark and a
    # chain are expressible at all: they are all "pick one, then keep meaning
    # that one".
    remember_target         132
    add_state               127   name:state by:i32

category instance = 0x12
    set_instance_data       112   field:u32 value:u32

    # The value is WHO, not a number: it stores the target's guid, which is not
    # known until the step runs. That is why it cannot be set_instance_data64
    # with two literal halves, and why it takes no value at all.
    set_instance_data_guid  125   field:u32
    # Two halves, not a u64: an operand is one 32-bit cell, and widening every
    # one of them for the single verb that wants eight bytes -- a verb the live
    # world calls zero times -- is the wrong trade.
    set_instance_data64     113   field:u32 low:u32 high:u32?

category unit = 0x13
    set_unit_field          114   field:field value:u32
    set_unit_flag           115   value:flags
    remove_unit_flag        116   value:flags
    set_sheath              117   state:u32

    # Make the step's subject immune to something, or stop being. `kind` is
    # SharedDefines.h's SpellImmunity -- 3 is damage of a school, 2 is the
    # school itself, 5 is a mechanic -- and `value` is whatever enum that kind
    # indexes.
    #
    # Two enums in two columns rather than one verb per kind, because the six
    # kinds are the same operation on six different vocabularies, and a verb
    # each would be six names for ApplySpellImmune.
    set_immunity            131   kind:u32 value:flags apply:bool?
    emote_target            118   emote:emote

category quest = 0x14
    quest_event             119   quest:quest all:bool?
    cast_event              120   creature:creature spell:spell all:bool?
    killed_monster          121   creature:creature
